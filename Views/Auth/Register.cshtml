@{
    ViewData["Title"] = "BursTar - Kayıt Ol";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-lg border-0 rounded-lg mt-5">
            <div class="card-header bg-primary text-white text-center py-4">
                <div class="mb-2">
                    <img src="~/images/logo.png.png" alt="BursTar Logo" style="height: 60px; object-fit: contain;" />
                </div>
                <h3 class="font-weight-light my-2">BursTar Kayıt Paneli</h3>
            </div>
            <div class="card-body p-4">
                
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger text-center">@ViewBag.Error</div>
                }

                <form asp-controller="Auth" asp-action="Register" method="post">
                    <div class="form-floating mb-3">
                        <input class="form-control" type="email" name="email" placeholder="name@example.com" required />
                        <label>Email Adresi</label>
                    </div>
                    
                    <div class="form-floating mb-3">
                        <input class="form-control" type="password" name="password" placeholder="Şifre" required />
                        <label>Şifre</label>
                    </div>

                    <div class="form-floating mb-4">
                        <select class="form-select" name="role" required>
                            <option value="">Lütfen seçiniz...</option>
                            <option value="student">Öğrenci</option>
                            <option value="institution">Kurum veya Şahıs (Burs Veren)</option>
                        </select>
                        <label>Hesap Türünüz</label>
                    </div>
                    
                    <div class="d-grid gap-2 mt-4 mb-0">
                        <button class="btn btn-primary btn-lg" type="submit">Hesabımı Oluştur</button>
                    </div>
                </form>
            </div>
            <div class="card-footer text-center py-3">
                <div class="small"><a href="/Auth/Login" class="text-primary">Zaten bir hesabınız var mı? Giriş Yapın.</a></div>
            </div>
        </div>
    </div>
</div>