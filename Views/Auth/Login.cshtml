@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-lg border-0 rounded-lg mt-5">
            <div class="card-header bg-white text-center py-4 border-bottom">
                <img src="~/images/burstar-logo.png" alt="BURSTAR" class="site-logo site-logo--auth" />
                <h5 class="font-weight-light mb-0 mt-3 text-muted">Giriş Paneli</h5>
            </div>
            <div class="card-body p-4">
                
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger text-center">@ViewBag.Error</div>
                }

                <form asp-controller="Auth" asp-action="Login" method="post">
                    <div class="form-floating mb-3">
                        <input class="form-control" type="email" name="email" placeholder="name@example.com" required />
                        <label>Email Adresi</label>
                    </div>
                    
                    <div class="form-floating mb-4">
                        <input class="form-control" type="password" name="password" placeholder="Şifre" required />
                        <label>Şifre</label>
                    </div>
                    
                    <div class="d-grid gap-2 mt-4 mb-0">
                        <button class="btn btn-success btn-lg" type="submit">Giriş Yap</button>
                    </div>
                </form>
            </div>
            <div class="card-footer text-center py-3">
                <div class="small"><a href="/Auth/Register" class="text-success">Hesabınız yok mu? Hemen Kayıt Olun.</a></div>
            </div>
        </div>
    </div>
</div>