@model IEnumerable<BursTakip.Models.ScholarshipProgram>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Institution)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProgramName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Amount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DurationMonths)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Quota)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GenderCriteria)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DepartmentCriteria)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MinGPA)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ApplicationDeadline)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SubmissionDeadline)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AdminNote)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SubmittedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ApprovedAt)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Institution.InstitutionName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProgramName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Amount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DurationMonths)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Quota)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.GenderCriteria)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DepartmentCriteria)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MinGPA)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ApplicationDeadline)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SubmissionDeadline)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AdminNote)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SubmittedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ApprovedAt)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ProgramID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ProgramID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ProgramID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
