@model IEnumerable<BursTakip.Models.ScholarshipProgram>
@{
    ViewData["Title"] = "Burs İlanlarım";
}

<div class="container mt-4">
    <!-- Kurum Menüsü -->
    <div class="mb-4">
        <a asp-controller="Institution" asp-action="Index" class="btn btn-outline-dark">Profil Bilgilerim</a>
        <a asp-controller="Scholarship" asp-action="Index" class="btn btn-dark">Burs İlanlarım</a>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-secondary mb-0">Yayınladığım Burs İlanları</h3>
        <a asp-action="Create" class="btn btn-success fw-bold">+ Yeni Burs İlanı Ekle</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success fw-bold">@TempData["Success"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-warning">Henüz hiçbir burs ilanı oluşturmadınız. Hemen yeni bir ilan ekleyerek öğrencilere destek olmaya başlayabilirsiniz.</div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-white pt-3 pb-0 border-0 d-flex justify-content-between">
                            <h5 class="text-primary fw-bold">@item.ProgramName</h5>
                            <span class="badge bg-success">@item.Status</span>
                        </div>
                        <div class="card-body">
                            <ul class="list-unstyled mb-0">
                                <li><strong>Miktar:</strong> @item.Amount.ToString("N2") ₺ / Ay</li>
                                <li><strong>Süre:</strong> @item.DurationMonths Ay</li>
                                <li><strong>Son Başvuru:</strong> <span class="text-danger fw-bold">@item.ApplicationDeadline.ToString("dd.MM.yyyy")</span></li>
                            </ul>
                        </div>
                        <div class="card-footer bg-white border-top-0 d-flex justify-content-between">
                            <a asp-action="Applications" asp-route-id="@item.ProgramID" class="btn btn-sm btn-outline-primary fw-bold">Başvuruları Değerlendir</a>
                            
                            <form asp-action="Delete" method="post" onsubmit="return confirm('Bu ilanı silmek istediğinize emin misiniz? (Bağlı başvurular da silinir)');">
                                <input type="hidden" name="id" value="@item.ProgramID" />
                                <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>