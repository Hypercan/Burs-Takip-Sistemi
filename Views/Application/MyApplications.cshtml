@model IEnumerable<BursTakip.Models.Application>
@{
    ViewData["Title"] = "Başvurularım";
}

<div class="container mt-4">
    <h3 class="mb-4 text-primary">Burs Başvurularım</h3>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success fw-bold">@TempData["Success"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-warning">Henüz hiçbir bursa başvuru yapmadınız. Ana sayfadan aktif bursları inceleyebilirsiniz.</div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th class="ps-3">Burs Adı</th>
                            <th>Kurum</th>
                            <th>Başvuru Tarihi</th>
                            <th>Durum</th>
                            <th>Kurumdan Gelen Not</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">@app.Program.ProgramName</td>
                                <td>@app.Program.Institution.InstitutionName</td>
                                <td>@app.AppliedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
    @if (app.Status == "Beklemede" && app.Program.ApplicationDeadline < DateTime.Now)
    {
        <span class="badge bg-secondary text-white">Süresi Doldu / Kapandı</span>
    }
    else if(app.Status == "Beklemede") 
    { 
        <span class="badge bg-warning text-dark">Beklemede</span> 
    }
    else if(app.Status == "Onaylandı") 
    { 
        <span class="badge bg-success">Onaylandı</span> 
    }
    else 
    { 
        <span class="badge bg-danger">Reddedildi</span> 
    }
</td>
                                <td><small class="text-muted">@app.InstitutionNote</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>